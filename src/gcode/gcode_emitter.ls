# Multi-Flavor G-code Serializer and NIST RS274/NGC Code Generator
# Supports Marlin, Klipper, RepRapFirmware, and LinuxCNC dial-in configurations

Point2D = require '../geometry2d/point2d'
{ ToolpathType } = require '../toolpath/toolpath_segment'

class GcodeFlavor
  @MARLIN   = 'Marlin'
  @KLIPPER  = 'Klipper'
  @REPRAP   = 'RepRap'
  @LINUXCNC = 'LinuxCNC'

class GcodeEmitter
  (opts = {}) ->
    @flavor          = opts.flavor or GcodeFlavor.MARLIN
    @bed-temp        = opts.bed-temp or 60
    @hotend-temp     = opts.hotend-temp or 210
    @filament-dia    = opts.filament-dia or 1.75
    @retract-length  = opts.retract-length or 0.8  # mm
    @retract-speed   = opts.retract-speed or 3600  # mm/min
    @z-hop           = opts.z-hop or 0.2           # mm
    @relative-e      = if opts.relative-e? then opts.relative-e else true

    # Filament cross-sectional area
    r = @filament-dia * 0.5
    @filament-area = Math.PI * r * r

  calculate-extrusion-length: (distance, layer-height, extrusion-width) ->
    # Volume of extruded plastic = distance * layer_height * extrusion_width
    # Volume in filament = E_len * filament_area
    vol = distance * layer-height * extrusion-width
    vol / @filament-area

  emit-start-gcode: (lines = []) ->
    lines.push "; =========================================="
    lines.push "; Generated by Kerf 3D Slicing Engine"
    lines.push "; Flavor: #{@flavor}"
    lines.push "; =========================================="
    lines.push "G21 ; Millimeter units"
    lines.push "G90 ; Absolute coordinates"

    if @relative-e
      lines.push "M83 ; Relative extruder positioning"
    else
      lines.push "M82 ; Absolute extruder positioning"

    lines.push "M140 S#{@bed-temp} ; Set bed temperature"
    lines.push "M104 S#{@hotend-temp} ; Set hotend temperature"
    lines.push "M190 S#{@bed-temp} ; Wait for bed temperature"
    lines.push "M109 S#{@hotend-temp} ; Wait for hotend temperature"
    lines.push "G28 ; Home all axes"
    lines.push "G92 E0 ; Reset extruder position"

    # Priming purge intro line
    lines.push "; Priming nozzle purge line"
    lines.push "G1 Z2.0 F3000"
    lines.push "G1 X10.0 Y10.0 F6000"
    lines.push "G1 Z0.3 F1200"
    lines.push "G1 X100.0 Y10.0 E9.0 F1500 ; Purge line"
    lines.push "G1 X100.0 Y10.4 F6000"
    lines.push "G1 X10.0 Y10.4 E18.0 F1500 ; Purge return"
    lines.push "G1 Z1.0 F1200"
    lines.push "G92 E0"
    lines

  emit-layer: (layer, current-state, lines = []) ->
    lines.push ""
    lines.push "; ------------------------------------------"
    lines.push "; LAYER:#{layer.layer-index} Z:#{layer.z.toFixed 3} DZ:#{layer.thickness.toFixed 3}"
    lines.push "; ------------------------------------------"

    # Move Z to layer height
    lines.push "G1 Z#{layer.z.toFixed 3} F1200"

    # Extrusion width default 0.45 mm
    extrusion-w = 0.45
    h = layer.thickness

    # Emit perimeter walls
    for poly in layer.perimeters
      pts = poly.points
      if pts.length < 2
        continue

      # Rapid travel to start of perimeter
      start-pt = pts[0]
      lines.push "G0 X#{start-pt.x.toFixed 3} Y#{start-pt.y.toFixed 3} F7200"

      # Trace perimeter loop
      n = pts.length
      for i from 0 til n
        j = (i + 1) % n
        p-next = pts[j]
        d = pts[i].distance-to p-next
        e-len = @calculate-extrusion-length d, h, extrusion-w
        lines.push "G1 X#{p-next.x.toFixed 3} Y#{p-next.y.toFixed 3} E#{e-len.toFixed 5} F3000"

    # Emit infill toolpaths
    for seg in layer.infill-paths
      # Travel to start of infill segment
      lines.push "G0 X#{seg.p1.x.toFixed 3} Y#{seg.p1.y.toFixed 3} F7200"
      d = seg.length!
      e-len = @calculate-extrusion-length d, h, extrusion-w
      lines.push "G1 X#{seg.p2.x.toFixed 3} Y#{seg.p2.y.toFixed 3} E#{e-len.toFixed 5} F4500"

    # Emit support toolpaths
    for seg in layer.support-paths
      lines.push "G0 X#{seg.p1.x.toFixed 3} Y#{seg.p1.y.toFixed 3} F7200"
      d = seg.length!
      e-len = @calculate-extrusion-length d, h, extrusion-w
      lines.push "G1 X#{seg.p2.x.toFixed 3} Y#{seg.p2.y.toFixed 3} E#{e-len.toFixed 5} F3600"

    lines

  emit-end-gcode: (lines = []) ->
    lines.push ""
    lines.push "; =========================================="
    lines.push "; End of Print Procedure"
    lines.push "; =========================================="
    lines.push "M104 S0 ; Turn off hotend"
    lines.push "M140 S0 ; Turn off heated bed"
    lines.push "M107 ; Turn off part cooling fan"
    lines.push "G91 ; Relative positioning"
    lines.push "G1 E-#{@retract-length} F#{@retract-speed} ; Retract filament"
    lines.push "G1 Z10.0 F1200 ; Lift nozzle away from print"
    lines.push "G90 ; Absolute positioning"
    lines.push "G1 X0 Y200 F6000 ; Present finished part"
    lines.push "M84 ; Disable stepper motors"
    lines.push "; End of G-code"
    lines

  generate-gcode: (layers) ->
    lines = []
    @emit-start-gcode lines
    state = { e-pos: 0.0 }
    for layer in layers
      @emit-layer layer, state, lines
    @emit-end-gcode lines
    lines.join "\n"

module.exports = {
  GcodeFlavor
  GcodeEmitter
}
